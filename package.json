{
  "name": "cms-visual-builder-hello-world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "codegen:clean": "rimraf src/generated/graphql",
    "codegen": "yarn codegen:clean && graphql-codegen",
    "dev": "next dev --experimental-https",
    "debug": "cross-env NODE_OPTIONS='--inspect' next dev --experimental-https",
    "build": "next build",
    "build:all": "yarn build:communication && yarn codegen && node postprocess-types.cjs && yarn build",
    "build:communication": "vite build --config vite-ci.config.ts",
    "start": "next start",
    "lint": "next lint",
    "download:schema": "node ./download-schema.js",
    "download:prod:schema": "node ./download-schema.js --env production"
  },
  "dependencies": {
    "@apollo/client": "^3.10.4",
    "@graphql-codegen/typescript-react-apollo": "^4.3.3",
    "@vercel/config": "^0.0.28",
    "clsx": "^2.1.1",
    "dom-to-image-more": "^3.5.0",
    "graphql": "^16.8.1",
    "html2canvas-pro": "^1.5.8",
    "next": "^15.3.6",
    "node-fetch": "^3.3.2",
    "object-hash": "^3.0.0",
    "react": "^18",
    "react-dom": "^18",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.1.1",
    "@graphql-codegen/client-preset": "^4.2.6",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-operations": "^4.6.1",
    "@parcel/watcher": "^2.4.1",
    "@types/node": "^20",
    "@types/object-hash": "^3.0.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10",
    "cross-env": "^7.0.3",
    "postcss": "^8",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.1",
    "tailwindcss-base-font-size": "^1.0.1",
    "typescript": "^5",
    "vite": "^5.4.11"
  },
  "packageManager": "yarn@4.12.0"
}
